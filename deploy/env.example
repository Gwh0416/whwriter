# Copy this file to deploy/.env on the server and change every secret.

APP_DIR=/opt/whwriter
DATA_DIR=/opt/whwriter-data
BACKUP_DIR=/opt/whwriter-backups
DOMAIN=_

APP_PORT=8080
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=whwriter
MYSQL_USER=whwriter
MYSQL_PASSWORD=change-mysql-password

JWT_SECRET=change-this-to-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeAdminPassword123

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

LLM_DEFAULT_TIMEOUT_SECONDS=300
LLM_PLANNER_TIMEOUT_SECONDS=300
LLM_WRITER_TIMEOUT_SECONDS=600
LLM_SETTLER_TIMEOUT_SECONDS=300
LLM_AUDITOR_TIMEOUT_SECONDS=300
LLM_REVISER_TIMEOUT_SECONDS=300
